<div class="w-full max-w-lg mx-auto mt-16 p-8 bg-white border border-stone-200 rounded-lg">
  <h2 class="font-serif text-2xl font-semibold mb-6 text-stone-800 text-center">ログイン</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="mb-4">
      <%= f.label :email, "メールアドレス", class: "block text-sm text-stone-500 mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",
            class: "w-full border border-stone-300 rounded px-3 py-2 text-sm" %>
    </div>

    <div class="mb-4">
      <%= f.label :password, "パスワード", class: "block text-sm text-stone-500 mb-1" %>
      <%= f.password_field :password, autocomplete: "current-password",
            class: "w-full border border-stone-300 rounded px-3 py-2 text-sm" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="mb-4 flex items-center gap-2">
        <%= f.check_box :remember_me, class: "rounded border-stone-300" %>
        <%= f.label :remember_me, "ログイン状態を保持する", class: "text-sm text-stone-600" %>
      </div>
    <% end %>

    <div class="mt-6">
      <%= f.submit "ログイン",
            class: "w-full bg-rose-800 text-white rounded py-2 text-sm font-medium cursor-pointer" %>
    </div>
  <% end %>

  <div class="block text-sm mt-3 cursor-pointer hover:underline">
    <%= render "devise/shared/links" %>
  </div>
</div>
