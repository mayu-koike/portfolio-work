<% content_for :title, "検討記録の詳細 | 美容クリニック手帳" %>
<div class="max-w-3xl mx-auto">

  <%= link_to "一覧に戻る", counseling_records_path, class: "text-sm text-stone-500 hover:underline mb-4 inline-block" %>

  <div class="flex justify-between items-start mb-6">
    <div>
      <span class="text-xs font-semibold text-rose-800 border border-rose-800 rounded px-3 py-1">
        <%= I18n.t("activerecord.enums.counseling_record.treatment_area.#{@counseling_record.treatment_area}") %>
      </span>
      <h1 class="font-serif text-2xl font-semibold text-stone-800 mt-4"><%= @counseling_record.clinic.name %></h1>
      <p class="text-sm text-stone-500 mt-1">担当医:<%= @counseling_record.doctor.presence || "未入力" %></p>
    </div>
    <div class="flex flex-col items-end gap-2.5">
      <div class="flex gap-2">
        <%= link_to "編集する", edit_counseling_record_path(@counseling_record),
              class: "text-sm text-stone-500 border border-stone-300 rounded px-4 py-2 hover:bg-stone-50" %>
        <%= button_to "削除する", counseling_record_path(@counseling_record), method: :delete,
              data: { turbo_confirm: "この検討記録を削除しますか?" },
              class: "text-sm text-rose-800 border border-rose-200 rounded px-4 py-2 hover:bg-rose-50" %>
      </div>
      <span class="text-xs font-semibold rounded-full px-3 py-1 <%= status_badge_class(@counseling_record.status) %>">
      <%= I18n.t("activerecord.enums.counseling_record.status.#{@counseling_record.status}") %></span>
      <p class="text-xs text-stone-500 text-right leading-relaxed">
        カウンセリング日 <%= @counseling_record.counseling_date&.strftime("%Y/%m/%d") %><br>
        登録日 <%= @counseling_record.created_at.strftime("%Y/%m/%d") %>
      </p>
    </div>
  </div>

  <div class="flex flex-col gap-5">

    <!-- ブロック1:悩み・希望→提案施術→提案理由 -->
    <div class="bg-white border border-stone-200 rounded-lg p-7">
      <p class="text-base font-semibold text-rose-800 mb-3">悩み・希望</p>
      <p class="font-bold text-base leading-relaxed text-stone-800 border-rose-800 mb-5">
        <%= @counseling_record.concerns.presence || "記載なし" %>
      </p>
      <p class="text-base font-semibold text-rose-800 mb-3">提案施術</p>
      <p class="text-base font-bold text-stone-800 mb-5"><%= @counseling_record.treatment.name %></p>
      <p class="text-base font-semibold text-rose-800 mb-3">提案理由</p>
      <p class="text-base font-bold text-stone-800 leading-relaxed"><%= @counseling_record.proposal_reason.presence || "記載なし" %></p>
    </div>

    <!-- ブロック2:見積・DT・効果期間・保証 -->
    <div class="bg-white border border-stone-200 rounded-lg p-7">
      <p class="text-base font-semibold text-rose-800 mb-4">条件</p>
      <div class="grid grid-cols-4 gap-0">
        <div class="pr-5">
          <p class="text-sm text-stone-500 mb-2">見積金額</p>
          <p class="font-mono text-xl font-bold text-stone-800">
            <% if @counseling_record.estimated_cost.present? %>
              <span class="text-sm text-stone-500 mr-0.5">¥</span><%= number_with_delimiter(@counseling_record.estimated_cost) %>
            <% else %>-<% end %>
          </p>
        </div>
        <div class="px-5 border-l border-stone-200">
          <p class="text-sm text-stone-500 mb-2">ダウンタイム</p>
          <p class="font-mono text-xl font-bold text-stone-800"><%= @counseling_record.downtime.present? ? "#{@counseling_record.downtime}日" : "-" %></p>
        </div>
        <div class="px-5 border-l border-stone-200">
          <p class="text-sm text-stone-500 mb-2">効果持続期間</p>
          <p class="text-base font-bold text-stone-800"><%= @counseling_record.effect_duration.presence || "-" %></p>
        </div>
        <div class="pl-5 border-l border-stone-200">
          <p class="text-sm text-stone-500 mb-2">修正保証</p>
          <p class="text-base font-bold text-stone-800"><%= @counseling_record.revision_guarantee ? "あり" : "なし" %></p>
        </div>
      </div>
    </div>

    <!-- ブロック3:評価 -->
  <div class="bg-rose-50 border border-stone-200 rounded-lg p-7">
  <p class="text-base font-semibold text-rose-800 mb-3">評価</p>

  <div class="flex justify-between items-center py-3 border-b border-dashed border-stone-300">
    <span class="text-sm font-semibold text-stone-800">提案内容の納得感</span>
    <div class="flex items-center gap-3">
      <div class="flex gap-1">
        <% 5.times do |i| %>
          <span class="w-4 h-4 rounded-full <%= i < (@counseling_record.proposal_satisfaction || 0) ? 'bg-rose-800' : 'bg-stone-200' %>"></span>
        <% end %>
      </div>
      <span class="text-sm text-stone-700"><%= @counseling_record.proposal_satisfaction.presence || "-" %> / 5</span>
    </div>
  </div>

  <div class="flex justify-between items-center py-3">
    <span class="text-sm font-semibold text-stone-800">リスク説明の誠実さ</span>
    <div class="flex items-center gap-3">
      <div class="flex gap-1">
        <% 5.times do |i| %>
          <span class="w-4 h-4 rounded-full <%= i < (@counseling_record.risk_disclosure_honesty || 0) ? 'bg-rose-800' : 'bg-stone-200' %>"></span>
        <% end %>
      </div>
      <span class="text-sm text-stone-700"><%= @counseling_record.risk_disclosure_honesty.presence || "-" %>/ 5</span>
    </div>
  </div>
</div>
    <!-- ブロック4:補足メモ -->
    <div class="bg-white border border-stone-200 rounded-lg p-7">
      <p class="text-base font-semibold text-rose-800 mb-3">補足メモ</p>
      <p class="text-sm text-stone-800 leading-relaxed"><%= @counseling_record.notes.presence || "記載なし" %></p>
    </div>

  </div>
</div>
