<% content_for :title, "検討記録を編集 | 美容クリニック手帳" %>
<div class="max-w-2xl mx-auto">
  <%= link_to "詳細に戻る", counseling_record_path(@counseling_record), class: "text-sm text-stone-500 hover:underline mb-4 inline-block" %>

  <h1 class="font-serif text-2xl font-semibold text-stone-800 mb-1">検討記録を編集</h1>
  <p class="text-sm text-stone-500 mb-8"><%= @counseling_record.clinic.name %>・<%= @counseling_record.counseling_date&.strftime("%Y/%m/%d") %>の記録</p>

  <%= form_with model: @counseling_record, class: "bg-white border border-stone-200 rounded-lg p-8" do |f| %>

    <!-- 基本情報 -->
    <fieldset class="mb-8">
      <legend class="text-xs font-semibold text-rose-800 tracking-wide mb-4 pb-2 border-b border-stone-200 w-full">基本情報</legend>
      <div class="grid grid-cols-2 gap-x-5 gap-y-4">
        <div class="flex flex-col gap-1">
          <%= label_tag :clinic_name do %>クリニック名 <span class="text-rose-800">*</span><% end %>
          <%= text_field_tag :clinic_name, @counseling_record.clinic&.name,
                placeholder: "例:Aクリニック新宿院",
                class: "w-full border border-stone-300 rounded px-3 py-2 text-sm" %>
        </div>

        <div class="flex flex-col gap-1">
          <%= f.label :doctor, "担当医", class: "text-xs text-stone-500" %>
          <%= f.text_field :doctor, placeholder: "例:山田医師",
                class: "w-full border border-stone-300 rounded px-3 py-2 text-sm" %>
        </div>

        <div class="flex flex-col gap-1">
          <%= f.label :treatment_area do %>施術部位 <span class="text-rose-800">*</span><% end %>
          <%= f.select :treatment_area,
                CounselingRecord.treatment_areas.keys.map { |key|
                  [I18n.t("activerecord.enums.counseling_record.treatment_area.#{key}"), key]
                },
                {},
                class: "w-full border border-stone-300 rounded px-3 py-2 text-sm" %>
        </div>

        <div class="flex flex-col gap-1">
          <%= f.label :counseling_date do %>カウンセリング日 <span class="text-rose-800">*</span><% end %>
          <%= f.date_field :counseling_date,
                class: "w-full border border-stone-300 rounded px-3 py-2 text-sm" %>
        </div>
      </div>
    </fieldset>

    <!-- 検討内容 -->
    <fieldset class="mb-8">
      <legend class="text-xs font-semibold text-rose-800 tracking-wide mb-4 pb-2 border-b border-stone-200 w-full">検討内容</legend>
      <div class="grid grid-cols-2 gap-x-5 gap-y-4">
        <div class="col-span-2 flex flex-col gap-1">
          <%= f.label :concerns, "悩み・希望", class: "text-xs text-stone-500" %>
          <%= f.text_area :concerns, rows: 2, placeholder: "例:奥二重をぱっちりさせたい",
                class: "w-full border border-stone-300 rounded px-3 py-2 text-sm" %>
        </div>

        <div class="flex flex-col gap-1">
          <%= f.label :treatment_id do %>提案施術 <span class="text-rose-800">*</span><% end %>
          <%= f.collection_select :treatment_id, Treatment.all, :id, :name,
                {},
                class: "w-full border border-stone-300 rounded px-3 py-2 text-sm" %>
        </div>

        <div class="flex flex-col gap-1">
          <%= f.label :estimated_cost, "見積金額(円)", class: "text-xs text-stone-500" %>
          <%= f.number_field :estimated_cost, placeholder: "350000",
                class: "w-full border border-stone-300 rounded px-3 py-2 text-sm [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none" %>
        </div>

        <div class="col-span-2 flex flex-col gap-1">
          <%= f.label :proposal_reason, "提案理由", class: "text-xs text-stone-500" %>
          <%= f.text_area :proposal_reason, rows: 2, placeholder: "例:ダウンタイムが短く、自然な仕上がりになるため。",
                class: "w-full border border-stone-300 rounded px-3 py-2 text-sm" %>
        </div>

        <div class="flex flex-col gap-1">
          <%= f.label :downtime, "ダウンタイム(日数)", class: "text-xs text-stone-500" %>
          <%= f.number_field :downtime, placeholder: "3",
                class: "w-full border border-stone-300 rounded px-3 py-2 text-sm" %>
        </div>

        <div class="flex flex-col gap-1">
          <%= f.label :effect_duration, "効果持続期間", class: "text-xs text-stone-500" %>
          <%= f.text_field :effect_duration, placeholder: "例:半永久 / 1〜2年",
                class: "w-full border border-stone-300 rounded px-3 py-2 text-sm" %>
        </div>

        <div class="col-span-2 flex flex-col gap-2">
          <span class="text-xs text-stone-500">修正保証の有無</span>
          <div class="flex gap-5 items-center">
            <label class="flex items-center gap-1.5 text-sm text-stone-700">
              <%= f.radio_button :revision_guarantee, "true", class: "border-stone-300" %> あり
            </label>
            <label class="flex items-center gap-1.5 text-sm text-stone-700">
              <%= f.radio_button :revision_guarantee, "false", class: "border-stone-300" %> なし
            </label>
          </div>
        </div>
      </div>
    </fieldset>

    <!-- 評価 -->
    <fieldset class="mb-8">
      <legend class="text-xs font-semibold text-rose-800 tracking-wide mb-4 pb-2 border-b border-stone-200 w-full">評価(5段階)</legend>

      <p class="bg-rose-50 text-rose-800 text-xs rounded px-4 py-3 mb-4">
        上で入力した<strong>悩み・希望</strong>と<strong>提案内容</strong>を踏まえて、次の項目に回答してください。
      </p>

      <div class="flex justify-between items-center py-3 border-b border-dashed border-stone-200 text-sm">
        <span>提案内容の納得感(自分の要望にどれだけ応えていたか)</span>
        <%= f.select :proposal_satisfaction, (1..5).to_a, { include_blank: "選択" },
              class: "border border-stone-300 rounded px-2 py-1.5 text-sm w-24" %>
      </div>
      <div class="flex justify-between items-center py-3 text-sm">
        <span>リスク説明の誠実さ</span>
        <%= f.select :risk_disclosure_honesty, (1..5).to_a, { include_blank: "選択" },
              class: "border border-stone-300 rounded px-2 py-1.5 text-sm w-24" %>
      </div>
    </fieldset>

    <!-- 管理・補足 -->
    <fieldset class="mb-2">
      <legend class="text-xs font-semibold text-rose-800 tracking-wide mb-4 pb-2 border-b border-stone-200 w-full">管理・補足</legend>
      <div class="grid grid-cols-2 gap-x-5 gap-y-4">
        <div class="flex flex-col gap-1">
          <%= f.label :status, "検討状況", class: "text-xs text-stone-500" %>
          <%= f.select :status,
                CounselingRecord.statuses.keys.map { |key|
                  [I18n.t("activerecord.enums.counseling_record.status.#{key}"), key]
                },
                {},
                class: "w-full border border-stone-300 rounded px-3 py-2 text-sm" %>
        </div>

        <div class="col-span-2 flex flex-col gap-1">
          <%= f.label :notes, "補足メモ", class: "text-xs text-stone-500" %>
          <%= f.text_area :notes, rows: 2, placeholder: "その他気づいたこと",
                class: "w-full border border-stone-300 rounded px-3 py-2 text-sm" %>
        </div>
      </div>
    </fieldset>

    <div class="flex gap-3 mt-8">
      <%= f.submit "更新する", class: "flex-1 bg-rose-800 text-white rounded py-2.5 text-sm font-medium hover:bg-rose-900 cursor-pointer" %>
      <%= link_to "キャンセル", counseling_record_path(@counseling_record),
            class: "flex-1 text-center bg-stone-100 text-stone-600 rounded py-2.5 text-sm font-medium hover:bg-stone-200" %>
    </div>
  <% end %>
</div>
