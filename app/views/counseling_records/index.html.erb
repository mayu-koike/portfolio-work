<% content_for :title, "検討記録一覧 | 美容クリニック手帳" %>
<div class="max-w-6xl mx-auto">

  <div class="flex justify-between items-end pb-4 mb-5 border-b border-stone-200">
    <div>
      <h1 class="font-serif text-2xl font-semibold text-stone-800">検討記録一覧(比較)</h1>
      <p class="text-sm text-stone-500 mt-1">全<%= @counseling_records.size %>件・カウンセリング済みのクリニックを横並びで比較できます</p>
    </div>
    <%= link_to "+ 新規登録", new_counseling_record_path,
          class: "text-sm text-white bg-rose-800 rounded px-5 py-2.5 hover:bg-rose-900 font-medium" %>
  </div>

  <%= form_with url: counseling_records_path, method: :get, local: true,
        class: "flex items-center gap-3 bg-white border border-stone-200 rounded-lg px-4 py-3.5 mb-5" do %>
    <label for="status" class="text-sm text-stone-500">検討状況で絞り込み</label>
    <%= select_tag :status,
          options_for_select(
            CounselingRecord.statuses.keys.map { |key|
              [I18n.t("activerecord.enums.counseling_record.status.#{key}"), key]
            },
            params[:status]
          ),
          include_blank: "すべて",
          onchange: "this.form.submit()",
          class: "border border-stone-300 rounded px-3 py-1.5 text-sm" %>
  <% end %>

  <div class="bg-white border border-stone-200 rounded-lg overflow-x-auto">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-stone-800">
          <th class="text-left text-xs font-semibold text-rose-800 tracking-wide px-3 py-3 whitespace-nowrap">部位</th>
          <th class="text-left text-xs font-semibold text-rose-800 tracking-wide px-3 py-3 whitespace-nowrap">クリニック</th>
          <th class="text-left text-xs font-semibold text-rose-800 tracking-wide px-3 py-3 whitespace-nowrap">提案施術</th>
          <th class="text-left text-xs font-semibold text-rose-800 tracking-wide px-3 py-3 whitespace-nowrap">見積金額</th>
          <th class="text-left text-xs font-semibold text-rose-800 tracking-wide px-3 py-3 whitespace-nowrap">ダウンタイム</th>
          <th class="text-left text-xs font-semibold text-rose-800 tracking-wide px-3 py-3 whitespace-nowrap">効果持続期間</th>
          <th class="text-left text-xs font-semibold text-rose-800 tracking-wide px-3 py-3 whitespace-nowrap">修正保証</th>
          <th class="text-left text-xs font-semibold text-rose-800 tracking-wide px-3 py-3 whitespace-nowrap">リスク説明</th>
          <th class="text-left text-xs font-semibold text-rose-800 tracking-wide px-3 py-3 whitespace-nowrap">納得感</th>
          <th class="text-left text-xs font-semibold text-rose-800 tracking-wide px-3 py-3 whitespace-nowrap">検討状況</th>
          <th class="px-3 py-3"></th>
        </tr>
      </thead>
      <tbody>
        <% @counseling_records.each do |record| %>
          <tr class="border-b border-stone-200">
            <td class="px-3 py-4 whitespace-nowrap">
              <%= I18n.t("activerecord.enums.counseling_record.treatment_area.#{record.treatment_area}") %>
            </td>
            <td class="px-3 py-4 font-semibold text-stone-800 whitespace-nowrap"><%= record.clinic.name %></td>
            <td class="px-3 py-4 whitespace-nowrap"><%= record.treatment.name %></td>
            <td class="px-3 py-4 font-mono whitespace-nowrap">
              <% if record.estimated_cost.present? %>¥<%= number_with_delimiter(record.estimated_cost) %><% end %>
            </td>
            <td class="px-3 py-4 whitespace-nowrap"><%= record.downtime.present? ? "#{record.downtime}日" : "-" %></td>
            <td class="px-3 py-4 whitespace-nowrap"><%= record.effect_duration.presence || "-" %></td>
            <td class="px-3 py-4 whitespace-nowrap">
              <% if record.revision_guarantee %>
                <span class="text-xs bg-rose-50 text-rose-800 rounded px-2.5 py-1">あり</span>
              <% else %>
                <span class="text-xs bg-stone-100 text-stone-500 rounded px-2.5 py-1">なし</span>
              <% end %>
            </td>
            <td class="px-3 py-4 whitespace-nowrap"><%= record.risk_disclosure_honesty.presence || "-" %> / 5</td>
            <td class="px-3 py-4 whitespace-nowrap"><%= record.proposal_satisfaction.presence || "-" %> / 5</td>
            <td class="px-3 py-4 whitespace-nowrap">
              <span class="text-xs font-semibold rounded-full px-3 py-1
                <%= case record.status
                    when "decided" then "bg-rose-800 text-white"
                    when "considering" then "bg-amber-50 text-amber-700"
                    when "booked" then "bg-sky-50 text-sky-700"
                    else "bg-stone-100 text-stone-500"
                    end %>">
                <%= I18n.t("activerecord.enums.counseling_record.status.#{record.status}") %>
              </span>
            </td>
            <td class="px-3 py-4 text-right whitespace-nowrap">
              <%= link_to "詳細", counseling_record_path(record), class: "text-xs text-stone-500 border border-stone-300 rounded px-3 py-1.5 hover:bg-stone-50" %>
              <%= link_to "編集", edit_counseling_record_path(record), class: "text-xs text-stone-500 border border-stone-300 rounded px-3 py-1.5 hover:bg-stone-50 ml-1" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <% if @counseling_records.empty? %>
      <p class="text-center text-sm text-stone-400 py-16">まだ検討記録がありません。「+ 新規登録」から追加してください。</p>
    <% end %>
  </div>
</div>
